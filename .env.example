# Copy this file to .env before starting the stack.
# Use an alphanumeric password so it can safely be used in the database URL.
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=airflow
POSTGRES_ANALYTICS_DB=customer_analytics

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW_SECRET_KEY=replace-with-a-long-random-secret
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-this-admin-password
AIRFLOW_ADMIN_FIRSTNAME=Chetan
AIRFLOW_ADMIN_LASTNAME=Developer
AIRFLOW_ADMIN_EMAIL=chetan1930@example.com
